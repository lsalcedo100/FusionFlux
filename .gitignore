# Third-party scientific data: fetched on demand, never redistributed.
# ITPA HDB5 STD5, https://osf.io/drwcq  (python3 hdb5.py download)
data/raw/hdb5_std5.csv
# The full DB5.2.3 revision Result 11 replicates on, from the same OSF project
# (python3 -c "import replication; replication.download_db523()")
data/raw/hdb5_db523.csv
# Result 13's second domain: mammalian BMR, Figshare article 3549807
# (python3 -c "import allometry; allometry.download_allometry()")
data/raw/allometry_bmr.txt
# Result 15's tree-allometry ladder: the Biomass And Allometry Database,
# GitHub release v1.0.1, CC0
# (python3 -c "import tree_allometry; tree_allometry.download_baad()")
data/raw/baad_data.zip
site/index.html

# Copied into the package at build time from results/predictor.json by
# setup.py, so the wheel carries the card its console command reads. Generated,
# never committed: results/predictor.json is the single source.
fusionflux/predictor.json

# Baseline copy made by `make reproduce`.
.reproduce_baseline/

# Local Claude Code configuration and skills. Personal tooling rather than
